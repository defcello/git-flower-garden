# Dependencies and build output
node_modules/
dist/
coverage/
*.tsbuildinfo

# Browser test output
playwright-report/
test-results/

# Logs
*.log
npm-debug.log*

# Local git-flower-garden configuration and caches. Configurations name private
# paths and remotes; caches hold private repository objects. Neither belongs
# in this repository. Commit only git-flower-garden.example.json.
git-flower-garden.json
*.local.json
.git-flower-garden/
# Former name, so older local files stay ignored too.
git-garden.json
.git-garden/
.cache/

# Materialized demo fixtures (see `npm run fixture`)
tmp/

# Secrets
.env
.env.*

# Editors and operating systems
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
release/
