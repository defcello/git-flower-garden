{
  "name": "git-garden",
  "version": "0.0.0",
  "private": true,
  "description": "Visualize Git activity as a garden of commits.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "git-garden": "dist/cli.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "node src/cli.ts serve",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run build && npm test",
    "fixture": "node tests/fixtures/materialize.ts",
    "bench:ancestors": "node scripts/bench-ancestors.ts",
    "render:fixture": "node scripts/render-fixture.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.0",
    "ajv": "8.20.0",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.2"
  }
}
