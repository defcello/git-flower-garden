{
  "name": "@defcello/git-flower-garden",
  "version": "0.2.0-beta.1",
  "private": true,
  "description": "Visualize Git activity as a garden of commits.",
  "license": "MIT",
  "author": "DefCello",
  "homepage": "https://github.com/defcello/git-flower-garden#readme",
  "bugs": {
    "url": "https://github.com/defcello/git-flower-garden/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/defcello/git-flower-garden.git"
  },
  "keywords": [
    "git",
    "visualization",
    "dag",
    "monitor"
  ],
  "type": "module",
  "bin": {
    "git-flower-garden": "dist/cli.js"
  },
  "files": [
    "dist/",
    "!dist/**/*.map",
    "!dist/**/*.d.ts",
    "git-flower-garden.schema.json",
    "git-flower-garden.example.json",
    "README.md",
    "LICENSE",
    "docs/user-guide.md",
    "docs/art/*.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/ui/tsconfig.json && tsc -p tests/e2e/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "node src/cli.ts serve",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run build && npm test && npm run test:e2e",
    "fixture": "node tests/fixtures/materialize.ts",
    "bench:ancestors": "node scripts/bench-ancestors.ts",
    "render:fixture": "node scripts/render-fixture.ts",
    "bench:graph": "node --max-old-space-size=4096 scripts/bench-graph.ts",
    "dev:ui": "vite",
    "test:e2e": "playwright test",
    "rehearse:install": "node scripts/install-rehearsal.ts",
    "bench:live": "node scripts/bench-live.ts",
    "release:stage": "npm run build && node scripts/stage-release.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "ajv": "8.20.0",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
